<!DOCTYPE html>
<html>
<head><title>Панель администратора</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <div class="container">
    <div style="display:flex; justify-content:space-between;">
      <h2>Администратор: <%= user.name %></h2>
      <a href="/logout" class="btn btn-danger">Выйти</a>
    </div>

    <div style="display:flex; gap: 20px;">
      <!-- Добавление пользователя -->
      <div class="card" style="flex:1;">
        <h3>Добавить пользователя</h3>
        <form method="POST" action="/admin/add-user">
          <input type="text" name="login" placeholder="Логин" required>
          <input type="text" name="full_name" placeholder="ФИО" required>
          <select name="role" required>
            <option value="student">Студент</option>
            <option value="teacher">Преподаватель</option>
            <option value="admin">Администратор</option>
          </select>
          <input type="text" name="group_name" placeholder="Группа (для студентов)">
          <button type="submit">Создать (пароль: 123)</button>
        </form>
      </div>

      <!-- Добавление дисциплины -->
      <div class="card" style="flex:1;">
        <h3>Добавить дисциплину</h3>
        <form method="POST" action="/admin/add-discipline">
          <input type="text" name="name" placeholder="Название (например: Физика)" required>
          <select name="teacher_id" required>
            <% users.filter(u => u.role === 'teacher').forEach(t => { %>
              <option value="<%= t.id %>"><%= t.full_name %></option>
            <% }) %>
          </select>
          <button type="submit">Добавить</button>
        </form>
      </div>
    </div>

    <h3>Список пользователей</h3>
    <table>
      <tr><th>ID</th><th>Логин</th><th>ФИО</th><th>Роль</th><th>Группа</th></tr>
      <% users.forEach(u => { %>
        <tr><td><%= u.id %></td><td><%= u.login %></td><td><%= u.full_name %></td><td><%= u.role %></td><td><%= u.group_name || '-' %></td></tr>
      <% }) %>
    </table>
  </div>
</body>
</html>